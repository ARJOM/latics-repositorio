rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function profile()  { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function isAdmin()  { return hasProfile() && profile().active == true && profile().role == 'admin'; }
    function isEditor() { return hasProfile() && profile().active == true && profile().role in ['admin', 'editor']; }
    function changes()  { return request.resource.data.diff(resource.data).affectedKeys(); }
    function conteudo() {
      return ['areas', 'tecnologias', 'equipe', 'textos', 'videos', 'acoesExtensao', 'artigos'];
    }

    match /users/{uid} {
      allow read:   if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'pendente'
                    && request.resource.data.active == true;
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid && !changes().hasAny(['role', 'active']));
      allow delete: if false;
    }

    match /config/{doc} {
      allow read:  if true;
      allow write: if isEditor();
    }

    // Contadores de visualização (services/estatisticas.ts): qualquer visitante soma exatamente 1 ao total
    // de um item publicado; só editores leem. Caminho com 4 segmentos, fora do match genérico abaixo.
    match /estatisticas/{colecao}/itens/{id} {
      function publicado() { return get(/databases/$(db)/documents/$(colecao)/$(id)).data.active == true; }
      function soTotal()   { return request.resource.data.keys().hasOnly(['total']); }
      allow read:   if isEditor();
      allow create: if colecao in ['textos', 'tecnologias', 'videos', 'artigos'] && publicado()
                    && soTotal() && request.resource.data.total == 1;
      allow update: if colecao in ['textos', 'tecnologias', 'videos', 'artigos'] && publicado()
                    && soTotal() && request.resource.data.total == resource.data.total + 1;
      allow delete: if false;
    }

    // Conteúdo público: leitura de documentos ativos; escrita para editores; nada é apagado fisicamente.
    match /{colecao}/{id} {
      allow read:   if colecao in conteudo() && (resource.data.active == true || isEditor());
      allow create, update: if colecao in conteudo() && isEditor();
      allow delete: if false;
    }
  }
}
