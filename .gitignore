# O que o site gera (node_modules, dist, .firebase, logs, .env.local) está em web/.gitignore.
# Aqui fica só o que pode aparecer na raiz.

# Sistema e editores
.DS_Store
.idea/
.vscode/
*.swp

# Logs (ex.: firebase-debug.log ao rodar o CLI na raiz)
*.log

# Planos e anotações locais (fora do git por decisão)
/docs/
